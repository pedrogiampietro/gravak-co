RUST_BACKTRACE=1
LOG_VERBOSITY=2
AUTH_PORT=9958

DATA_LOCATION=./data
# Postgres; this is the container of `docker compose up -d`, and the default.
DATABASE_URL=postgres://gravak:gravak@localhost:5432/gravak
# Optional while developing against the local 5065 assets.
# SHOP_DATA=R:\\5065\\ini\\Shop.dat
# ITEMTYPE_DATA=R:\\5065\\ini\\itemtype.dat

# Shared by the auth and game servers: the game server hands out login tokens
# only to a connection that shows it. Without it, only connections from this
# machine get them. Use a long random value, the same for both servers.
# TRANSFER_SECRET=
