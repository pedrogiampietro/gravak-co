# The skills a pure first rebirth teaches (Redux `reborns`), with their
# levels from MagicType: CruelShade (Trojan to Trojan) takes 10/14/18/20% of
# the target's life left for 100 stamina, at most five of the caster's
# strongest blows; Reflect (Warrior to Warrior) sends one physical blow in ten
# back, never killing; Dodge (Fire Taoist to Fire Taoist) adds 10/20/30 dodge
# for 60 seconds.
[Skill]
ID=3050
Name=CruelShade
Mana=0
Stamina=100
Range=5.0
Radius=0.0
CooldownMs=1500
LifePercent=10
Starter=false
