# The game server's Postgres (server/docker-compose.yml while developing).
DATABASE_URL=postgres://gravak:gravak@localhost:5432/gravak
# The site's public address.
SITE_URL=http://localhost:3000
# Where the game servers listen; checked when server_status is missing.
GAME_HOST=127.0.0.1
AUTH_PORT=9958
GAME_PORT=5816
# The server clock of the guild wars (Brasília).
GUILD_WAR_UTC_OFFSET=-3

# Top bar links; each one hides while empty. Read at build time.
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/Tzjc5sM9Ry
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/gravak.co/
# The installer; without it, /downloads/GravakSetup.exe.
# NEXT_PUBLIC_DOWNLOAD_URL=
