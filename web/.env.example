# The game server's Postgres (server/docker-compose.yml while developing).
DATABASE_URL=postgres://gravak:gravak@localhost:5432/gravak
# The site's public address.
SITE_URL=http://localhost:3000
# Where the game servers listen; checked when server_status is missing.
GAME_HOST=127.0.0.1
AUTH_PORT=9958
GAME_PORT=5816
# The server clock of the guild wars (Brasília).
GUILD_WAR_UTC_OFFSET=-3

# Top bar links; each one hides while empty. Read at build time.
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/Tzjc5sM9Ry
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/gravak.co/
# The installer; without it, /downloads/GravakSetup.exe.
# NEXT_PUBLIC_DOWNLOAD_URL=
# A second place to download the installer (MediaFire), under the button.
# NEXT_PUBLIC_DOWNLOAD_MIRROR_URL=

# Cloudflare Turnstile on the sign-up and the download (dash.cloudflare.com,
# Turnstile). Without them the check passes while developing; in production
# sign-ups and downloads are refused. The site key is read at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Signs the installer links for nginx's secure_link (the same value as in
# the nginx site); without it the links go unsigned.
DOWNLOAD_LINK_SECRET=

# Signs the website's sign-in cookie (the shop); a long random value.
SESSION_SECRET=
# Mercado Pago (www.mercadopago.com.br/developers/panel/app): the access
# token (TEST-... while testing) and the webhook's secret signature.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Umami analytics (the gravak-umami service, its dashboard at /stats): the
# website's id there, read at build time; without it nothing is tracked.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Where the site sends its own events (sign-ups, downloads, orders).
# UMAMI_COLLECT_URL=http://127.0.0.1:3001/stats/api/send

# The Armory's turning hero (lib/armory.ts): the game client's executable and
# the game folder holding gravak.gpk; without ARMORY_BIN the page keeps the still art.
# ARMORY_BIN=/opt/gravak/armory/conquer-sandbox
# ARMORY_ASSETS=/var/www/gravak-update/game
# ARMORY_CACHE=/var/cache/gravak-armory
